[k8s-master]
master-1 ansible_host=${master_1_priv_ip}
master-2 ansible_host=${master_2_priv_ip}
master-3 ansible_host=${master_3_priv_ip}

[k8s-bootstrap-master]
master-ha-1 ansible_host=${master_1_priv_ip}

[k8s-ha-master-nodes]
master-ha-2 ansible_host=${master_2_priv_ip}
master-ha-3 ansible_host=${master_3_priv_ip}

[k8s-workers]
worker-1 ansible_host=${worker_1_priv_ip}
worker-2 ansible_host=${worker_2_priv_ip}



[k8s-cluster:children]
k8s-master
k8s-workers

[all:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_rsa
;ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -o StrictHostKeyChecking=accept-new root@${bastion_ip} -W %h:%p"
master_private_ip=${master_1_priv_ip}
k8s_api_endpoint=10.0.10.40:6443
k8s_api_host=10.0.10.40
;set calico or flannel
;default flannel
cni_plugin=calico